# Database
DATABASE_URL=postgresql://healthsuite:changeme@localhost:5432/healthsuite

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=vitals/#

# Patients seeded at startup as P0001..P{N} (synthetic)
SEED_PATIENTS=100

# Normal limits for the abnormal flag (placeholder assumptions)
HEART_RATE_MIN=50
HEART_RATE_MAX=120
SPO2_MIN=92
TEMPERATURE_MIN=35.5
TEMPERATURE_MAX=38.0

# App
LOG_LEVEL=INFO
