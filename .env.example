# Database
# DATABASE_URL is for running the app on the host; Compose builds its own from POSTGRES_* below.
DATABASE_URL=postgresql://healthsuite:changeme@localhost:5432/healthsuite
POSTGRES_USER=healthsuite
POSTGRES_PASSWORD=changeme
POSTGRES_DB=healthsuite
# Host port Compose publishes Postgres on (change if a local PostgreSQL already uses 5432).
# POSTGRES_HOST_PORT=5433

# Address the API (8000) and MQTT (1883) are published on. Default: all interfaces.
# Laptop (Stage A): set it to the Tailscale address (`tailscale ip -4`) so only the Oracle generator can connect.
# BIND_IP=100.x.y.z

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=vitals/#

# Where the worker reads readings from: mqtt (Stages A and B, default) or sqs (Stage C).
# In sqs mode SQS_QUEUE_URL is required and the AWS region comes from AWS_DEFAULT_REGION
# (on EC2 the credentials come from the instance role, so no keys go in this file).
# INPUT_MODE=mqtt
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/mini-hs-readings
# AWS_DEFAULT_REGION=ap-south-1
# Stage C database (RDS) needs SSL: append ?sslmode=verify-full&sslrootcert=<path to the AWS CA bundle>
# to DATABASE_URL (and use postgresql+psycopg2://, see GOTCHAS).

# Patients seeded at startup as P0001..P{N} (synthetic)
SEED_PATIENTS=100

# Normal limits for the abnormal flag (placeholder assumptions)
HEART_RATE_MIN=50
HEART_RATE_MAX=120
SPO2_MIN=92
TEMPERATURE_MIN=35.5
TEMPERATURE_MAX=38.0

# App
LOG_LEVEL=INFO

# Integration tests (pytest -m integration) against a running stack; skipped when unset.
# Laptop example; on the VM use its own host. Use the plain postgresql:// form here.
# TEST_BASE_URL=http://localhost:8000
# TEST_DATABASE_URL=postgresql://healthsuite:changeme@localhost:5432/healthsuite
# TEST_MQTT_HOST=localhost
# TEST_MQTT_PORT=1883
# Stage C: the SQS tests send straight to the queue (skipped when unset).
# TEST_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/mini-hs-readings
